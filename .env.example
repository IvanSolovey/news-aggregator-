# Telegram Bot (required)
TELEGRAM_BOT_TOKEN=          # Token from @BotFather
TELEGRAM_WEBHOOK_SECRET=     # Random string 32+ chars (protects webhook endpoint)

# Cron protection (required)
CRON_SECRET=                 # Random string (protects /api/cron endpoint)

# Upstash Redis (required)
UPSTASH_REDIS_REST_URL=      # From https://console.upstash.com
UPSTASH_REDIS_REST_TOKEN=    # From https://console.upstash.com

# Translation — configure at least one provider

# Option A: Claude (Anthropic) — enables inline 🌐 Перекласти button on each article
ANTHROPIC_API_KEY=           # From https://console.anthropic.com

# Option B: DeepL — used for auto-translation via /translate command (500K chars/month free)
DEEPL_API_KEY=               # From https://www.deepl.com/pro-api

# Option C: LibreTranslate (fallback, free public instances available)
LIBRETRANSLATE_URL=          # e.g. https://libretranslate.com
LIBRETRANSLATE_API_KEY=      # Only needed for paid LibreTranslate instances
